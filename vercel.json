{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "leadscore.sivesh-pb.com" }],
      "destination": "https://leadscore.nuential.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "leadscore.sivesh-pb.com" }],
      "destination": "https://leadscore.nuential.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "leadai.sivesh-pb.com" }],
      "destination": "https://leadscore.nuential.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "leadai.sivesh-pb.com" }],
      "destination": "https://leadscore.nuential.com/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "leadscoredev.sivesh-pb.com" }],
      "destination": "https://leadscoredev.nuential.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "leadscoredev.sivesh-pb.com" }],
      "destination": "https://leadscoredev.nuential.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|robots\\.txt|sitemap\\.xml|og\\.jpg|og\\.svg|share-card\\.jpg|favicon\\.svg|screenshots/).*)",
      "destination": "/index.html"
    }
  ]
}
